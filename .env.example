# Copie para .env e preencha. Nenhum valor real entra neste arquivo.

# ── Supabase ─────────────────────────────────────────────────
# URL e chave anônima são públicas (vão para o navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: ignora as políticas de RLS. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Aplicação ────────────────────────────────────────────────
# Domínio público, sem barra no fim. Usado por sitemap, robots,
# links de e-mail e callback de autenticação.
NEXT_PUBLIC_SITE_URL=https://matrizaprova.com.br

# ── E-mail transacional (Resend) ─────────────────────────────
RESEND_API_KEY=

# ── OpenAI (geração do plano de estudos) ─────────────────────
OPENAI_API_KEY=

# ── Sentry ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Só no ambiente de build (CI/Vercel): envia os source maps.
SENTRY_AUTH_TOKEN=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (produção: https://matrizaprova.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI — geração do plano de estudos por IA
OPENAI_API_KEY=

# Resend — e-mail transacional (boas-vindas, recuperação de senha)
RESEND_API_KEY=

# Secret do cron da Vercel (alertas de editais) — a Vercel envia em
# Authorization: Bearer <secret>. Gere com: openssl rand -hex 32
CRON_SECRET=

# Mercado Pago — Checkout Pro (venda do plano vitalício)
# Credencial de produção ou teste: Mercado Pago > Seus projetos > Credenciais de produção
MERCADOPAGO_ACCESS_TOKEN=

# Mercado Pago — secret do webhook (validação da assinatura x-signature)
# Mercado Pago > Seus projetos > Webhooks > Configurar notificações > Secret
MERCADOPAGO_WEBHOOK_SECRET=

# Sentry — monitoramento de erros (opcional)
# Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Project Settings > API Keys > Auth Tokens (upload de source maps no build)
SENTRY_AUTH_TOKEN=

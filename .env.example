# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dois domínios: landing e app logada
# Produção: https://matrizaprova.com (landing) e https://app.matrizaprova.com (app)
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — geração do plano de estudos por IA
OPENAI_API_KEY=

# Resend — e-mail transacional (boas-vindas, recuperação de senha)
RESEND_API_KEY=

# Secret do cron da Vercel (alertas de editais) — a Vercel envia em
# Authorization: Bearer <secret>. Gere com: openssl rand -hex 32
CRON_SECRET=

# InfinitePay — Checkout Integrado (venda do plano vitalício)
# Sua InfiniteTag (nome de usuário no app, sem o símbolo $).
# Ex.: INFINITEPAY_HANDLE=matrizaprova
INFINITEPAY_HANDLE=

# Opcional: liga o modo teste (só muda o flag exibido na UI; a InfinitePay
# não tem credencial de teste — o checkout é o mesmo).
INFINITEPAY_TEST=false

# Sentry — monitoramento de erros (opcional)
# Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Project Settings > API Keys > Auth Tokens (upload de source maps no build)
SENTRY_AUTH_TOKEN=
